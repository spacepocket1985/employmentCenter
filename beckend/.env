# === SERVER ===
PORT=5000
NODE_ENV=development

# === MONGODB ===
MONGO_URI=mongodb://localhost:27017/tec2Center

# === JWT ===
JWT_SECRET=tec2-center-jwt
JWT_EXPIRES_IN=7d

# === CORS ===
CORS_ORIGIN=

# === 1C CONFIG ===
ONE_C_SOURCE_PATH=Y:/1C_OB
ONE_C_LOCAL_PATH=C:/temp/1C_OB
ONE_C_ENCODING=cp1251
ONE_C_MENU_JOURNAL_ID=3BC
ONE_C_MONTHS_TO_LOAD=2

# === 1C FILES TO COPY ===
ONE_C_FILES=SC3172.DBF,SC3172.CDX,DT4295.DBF,DT4295.CDX,1SJOURN.DBF,1SJOURN.CDX

# === CRON SCHEDULE ===
ONE_C_PARSE_CRON=0 6 * * *
ONE_C_PARSE_CRON_FRIDAY=0 17 * * 5